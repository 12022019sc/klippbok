{
  "_readme": "Claude Code configuration. Machine-specific overrides go in settings.local.json (gitignored).",
  "permissions": {
    "allow": [
      "Skill",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(pip:*)",
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git reset --hard)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/debug-all-hooks.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/block-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/check-rybbit.sh"
          },
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/check-branch.sh"
          },
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/check-ports.sh"
          },
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/check-e2e.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/debug-all-hooks.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/lint-on-save.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/verify-no-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/check-rulecatch.sh"
          },
          {
            "type": "command",
            "command": "bash C:/Dev/Projects/klippbok-main/.claude/hooks/check-env-sync.sh"
          }
        ]
      }
    ]
  }
}
